# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/src/generated/prisma/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Product/context docs stay local. Files already tracked under docs/
# need `git rm -r --cached docs` before ignore takes effect.
/docs

# Agent-generated briefs (not product source)
TASKS-SECOND-DEV.md
BUILD_SUMMARY.md

# Playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright-mcp/

# Cursor
.cursor/

# Windows
Thumbs.db
Desktop.ini
