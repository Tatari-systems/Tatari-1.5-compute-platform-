# PostgreSQL
# Use Neon's pooled URL for application queries.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require"
# Use Neon's direct URL for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Auth.js
AUTH_SECRET="replace-with-a-generated-secret"
AUTH_GOOGLE_ID="replace-with-google-oauth-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-oauth-client-secret"
# Local Google callback: http://localhost:3000/api/auth/callback/google
AUTH_URL="http://localhost:3000"
